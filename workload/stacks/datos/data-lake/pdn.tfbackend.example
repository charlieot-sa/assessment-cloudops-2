# Backend del estado para PDN. Copiar como pdn.tfbackend (no se versiona) y usar:
#   terraform init -backend-config=pdn.tfbackend
# Un bucket de estado por cuenta; una clave por dominio y stack.
bucket       = "bg-pdn-tfstate-123456789012"
key          = "workload/datos/data-lake/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "alias/bg-tfstate"
use_lockfile = true
